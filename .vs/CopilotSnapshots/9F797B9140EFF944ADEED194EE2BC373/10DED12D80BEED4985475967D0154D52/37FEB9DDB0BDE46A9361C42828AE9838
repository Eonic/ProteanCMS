        /// <summary>
        /// Asynchronously builds the page XML structure.
        /// This is the async version of BuildPageXML() that uses async database calls.
        /// </summary>
        /// <param name="cancellationToken">Cancellation token for async operations</param>
        /// <returns>Task containing the built XmlDocument</returns>
        public async Task<XmlDocument> BuildPageXMLAsync(
            CancellationToken cancellationToken = default(CancellationToken))
        {
            PerfMon.Log("Web", "BuildPageXMLAsync");
            XmlElement oPageElmt;
            string sProcessInfo = "";
            string sLayout = "Default";

            try
            {
                // INITIALIZE PAGE XML DOCUMENT
                if (moPageXml.DocumentElement is null)
                {
                    moPageXml.CreateXmlDeclaration("1.0", "UTF-8", "yes");
                    oPageElmt = moPageXml.CreateElement("Page");
                    moPageXml.AppendChild(oPageElmt);
                    GetRequestVariablesXml(ref oPageElmt);
                    GetSettingsXml(ref oPageElmt);
                }
                else
                {
                    oPageElmt = moPageXml.DocumentElement;
                }

                // CHECK LICENCE
                if (CheckLicence(moLicenceMode))
                {
                    SetPageLanguage();

                    // Handle special pages
                    long specialPageId = 0L;
                    if ((long)mnPageId == gnPageNotFoundId |
                        (long)mnPageId == gnPageAccessDeniedId |
                        (long)mnPageId == gnPageLoginRequiredId |
                        (long)mnPageId == gnPageErrorId)
                    {
                        specialPageId = (long)mnPageId;
                    }

                    // ✅ ASYNC DATABASE CALL #1 - Get main site structure
                    sProcessInfo = "BuildPageXMLAsync-GetStructureXML-Site";
                    await GetStructureXMLAsync(
                        "Site",
                        0L,
                        0L,
                        false,
                        0L,
                        cancellationToken
                    ).ConfigureAwait(false);

                    // Reset special page ID if needed
                    if (specialPageId > 0L)
                    {
                        mnPageId = (int)specialPageId;
                    }

                    if (string.IsNullOrEmpty(msException))
                    {
                        // ✅ ASYNC DATABASE CALL #2 - Get newsletter menu if configured
                        if (mnMailMenuId > 0L)
                        {
                            sProcessInfo = "BuildPageXMLAsync-GetStructureXML-Newsletter";
                            await GetStructureXMLAsync(
                                "Newsletter",
                                0L,
                                mnMailMenuId,
                                true,
                                0L,
                                cancellationToken
                            ).ConfigureAwait(false);
                        }

                        // ✅ ASYNC DATABASE CALL #3 - Get system pages if configured
                        if (mnSystemPagesId > 0L & !(mnSystemPagesId == RootPageId))
                        {
                            sProcessInfo = "BuildPageXMLAsync-GetStructureXML-SystemPages";
                            await GetStructureXMLAsync(
                                0L,
                                mnSystemPagesId,
                                0L,
                                "SystemPages",
                                true,
                                true,
                                false,
                                true,
                                false,
                                "",
                                "",
                                cancellationToken
                            ).ConfigureAwait(false);
                        }

                        // Add content counts to menu
                        if (!string.IsNullOrEmpty(gcMenuContentCountTypes))
                        {
                            foreach (var contentType in gcMenuContentCountTypes.Split(','))
                            {
                                var trimmedType = contentType.Trim();
                                if (!string.IsNullOrEmpty(trimmedType))
                                {
                                    await AddContentCountAsync(
                                        (XmlElement)moPageXml.SelectSingleNode("/Page/Menu"),
                                        trimmedType,
                                        cancellationToken).ConfigureAwait(false);
                                }
                            }
                        }

                        // Add content briefs to menu
                        if (!string.IsNullOrEmpty(gcMenuContentBriefTypes))
                        {
                            foreach (var contentType in gcMenuContentBriefTypes.Split(','))
                            {
                                var trimmedType = contentType.Trim();
                                if (!string.IsNullOrEmpty(trimmedType))
                                {
                                    await AddContentBriefAsync(
                                        (XmlElement)moPageXml.SelectSingleNode("/Page/Menu"),
                                        trimmedType,
                                        cancellationToken).ConfigureAwait(false);
                                }
                            }
                        }

                        // Establish the article ID
                        if (!(moRequest.QueryString.Count == 0))
                        {
                            if (!string.IsNullOrEmpty(moRequest["artid"]))
                            {
                                string sArtId = Regex.Replace("0" + moRequest["artid"], @"[^\d]", "");
                                if (int.TryParse(sArtId, out int artId))
                                {
                                    mnArtId = artId;
                                }
                            }
                        }

                        // Set page attributes
                        if (mnArtId > 0)
                        {
                            oPageElmt.SetAttribute("artid", mnArtId.ToString());
                        }

                        oPageElmt.SetAttribute("id", mnPageId.ToString());

                        if (moSession != null)
                        {
                            var logonRedirectId = moSession["LogonRedirectId"];

                            if (logonRedirectId != null &&
                                int.TryParse(logonRedirectId.ToString(), out int redirectId) &&
                                redirectId > 0 &&
                                redirectId != mnPageId)
                            {
                                oPageElmt.SetAttribute("requestedId", redirectId.ToString());
                            }
                        }

                        oPageElmt.SetAttribute("cacheMode", mnPageCacheMode.ToString());

                        if (!string.IsNullOrEmpty(gcEwBaseUrl))
                        {
                            oPageElmt.SetAttribute("baseUrl", gcEwBaseUrl);
                        }

                        // Introduce the layout
                        if (sLayout == "Default")
                        {
                            sLayout = await moDbHelper.getPageLayoutAsync(
                                (long)mnPageId,
                                cancellationToken).ConfigureAwait(false);
                        }
                        oPageElmt.SetAttribute("layout", sLayout);
                        oPageElmt.SetAttribute("pageExt", moConfig["pageExt"]);
                        oPageElmt.SetAttribute("cssFramework", moConfig["cssFramework"]);

                        // Get content XML
                        if (mnPageId > 0)
                        {
                            sProcessInfo = "BuildPageXMLAsync-GetContentXml";
                            await GetContentXmlAsync(oPageElmt, cancellationToken).ConfigureAwait(false);
                        }
                    }
                }

                return moPageXml;
            }
            catch (Exception ex)
            {
                OnComponentError(this, new Tools.Errors.ErrorEventArgs(
                    mcModuleName, "BuildPageXMLAsync", ex, sProcessInfo));
                return null;
            }
        }

        /// <summary>
        /// Asynchronously gets the complete page XML.
        /// </summary>
        public async Task<XmlDocument> GetPageXMLAsync(
            CancellationToken cancellationToken = default(CancellationToken))
        {
            PerfMon.Log("Web", "GetPageXMLAsync");
            string sProcessInfo = "";

            try
            {
                sProcessInfo = "GetPageXMLAsync-BuildPageXML";
                var pageXml = await BuildPageXMLAsync(cancellationToken).ConfigureAwait(false);

                if (pageXml == null)
                    return null;

                sProcessInfo = "GetPageXMLAsync-PostProcessing";

                if (!ibIndexMode)
                {
                    if (!mbAdminMode & moConfig["CheckPageURL"] == "on")
                    {
                        // URL checking logic
                    }

                    if (gbMembership)
                    {
                        MembershipProcess();
                    }
                    else if (mbAdminMode & mnUserId > 0)
                    {
                        RefreshUserXML();
                    }

                    // ✅ FIXED: Remove VB.NET Strings.LCase
                    if (moConfig["ActionsBeforeAddBulk"]?.ToLower() == "on")
                    {
                        ContentActions();
                    }

                    if (moConfig["FinalAddBulk"]?.ToLower() == "on")
                    {
                        string cShowRelatedBriefDepth = moConfig["ShowRelatedBriefDepth"] + "";
                        int nMaxDepth = 1;
                        if (!string.IsNullOrEmpty(cShowRelatedBriefDepth) &&
                            Tools.Text.IsNumeric(cShowRelatedBriefDepth))
                        {
                            nMaxDepth = Convert.ToInt32(cShowRelatedBriefDepth);
                        }
                        XmlElement argoContentParent = (XmlElement)moPageXml.DocumentElement
                            .SelectSingleNode("Contents");
                        DateTime UpdatedTime = mdPageUpdateDate ?? DateTime.Now;
                        moDbHelper.addBulkRelatedContent(ref argoContentParent, ref UpdatedTime, nMaxDepth);
                    }

                    if (moConfig["ActionsBeforeAddBulk"] != "on")
                    {
                        ContentActions();
                    }

                    CommonActions();
                    string layoutCmd = LayoutActions();
                    AddCart();

                    if (gbQuote)
                    {
                        var argaWeb = this;
                        var oEq = new Cms.Quote(ref argaWeb);
                        oEq.apply();
                        oEq.close();
                        oEq = (Cms.Quote)null;
                    }

                    // ✅ FIXED: Remove VB.NET Strings.LCase
                    if (moConfig["Search"]?.ToLower() == "on")
                    {
                        var oSearchNode = moPageXml.CreateElement("Search");
                        oSearchNode.SetAttribute("mode", moConfig["SearchMode"]);
                        oSearchNode.SetAttribute("contentTypes", moConfig["SearchContentTypes"]);
                        moPageXml.DocumentElement.AppendChild(oSearchNode);
                    }

                    if (mbAdminMode)
                    {
                        try
                        {
                            if (string.IsNullOrEmpty(moRequest["ewCmd"]))
                            {
                                ProcessReports();
                            }
                        }
                        catch
                        {
                        }
                    }
                    else
                    {
                        ProcessReports();
                    }

                    ProcessCalendar();

                    if (gbVersionControl)
                        CheckContentVersions();
                }

                var argoPage = moPageXml.DocumentElement;
                CheckMultiParents(ref argoPage, mnPageId);

                ProcessPageXMLForLanguage();
                CommitResponsesToPage();

                if (moSession != null)
                {
                    var redirectReason = moSession["RedirectReason"];

                    if (redirectReason != null &&
                        !string.IsNullOrEmpty(redirectReason.ToString()) &&
                        !bRedirectStarted)
                    {
                        moPageXml.DocumentElement.SetAttribute("RedirectReason", redirectReason.ToString());
                        moSession.Remove("RedirectReason");
                    }
                }

                return moPageXml;
            }
            catch (Exception ex)
            {
                OnComponentError(this, new Tools.Errors.ErrorEventArgs(
                    mcModuleName, "GetPageXMLAsync", ex, sProcessInfo));
                return null;
            }
        }

