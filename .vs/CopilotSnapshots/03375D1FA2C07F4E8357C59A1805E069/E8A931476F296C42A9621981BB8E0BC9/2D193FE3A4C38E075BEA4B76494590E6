        /// <summary>
        /// Async version of Open() - initializes page context asynchronously
        /// This replaces the synchronous Open() call in the async request pipeline
        /// </summary>
        public async Task OpenAsync(CancellationToken cancellationToken = default)
        {
            PerfMon.Log("Web", "OpenAsync");
            string sProcessInfo = "";
            string cCloneContext = "";
            string rootPageIdFromConfig = "";
            try
            {
                // Open DB Connections (same as sync version)
                if (moDbHelper is null)
                {
                    moDbHelper = (Cms.dbHelper)GetDbHelper();
                }
                if (string.IsNullOrEmpty(moDbHelper.DatabaseName))
                {
                    if (bs5)
                    {
                        msRedirectOnEnd = "ptn/setup/default.ashx";
                    }
                    else
                    {
                        msRedirectOnEnd = "ewcommon/setup/default.ashx";
                    }
                    return; // Exit early if not configured
                }

                // Admin mode check
                if (moSession != null)
                {
                if (moSession["adminMode"] != null && Convert.ToBoolean(moSession["adminMode"]))
                    {
                        mbAdminMode = true;
                        moDbHelper.gbAdminMode = mbAdminMode;
                    }
                }

                if (!string.IsNullOrEmpty(moConfig["AdminAcct"]) && moConfig["AdminGroup"] != "AzureWebApp")
                {
                    impersonationMode = true;
                }

                // Get system page IDs for application level (ASYNC)
                if (goApp["PageNotFoundId"] is null)
                {
                    goApp["PageNotFoundId"] = (object)await moDbHelper.getPageIdFromPathAsync(
                        NotFoundPagePath,
                        false,
                        false,
                        cancellationToken
                    ).ConfigureAwait(false);
                }
                if (goApp["PageAccessDeniedId"] is null)
                {
                    goApp["PageAccessDeniedId"] = (object)await moDbHelper.getPageIdFromPathAsync(
                        AccessDeniedPagePath,
                        false,
                        false,
                        cancellationToken
                    ).ConfigureAwait(false);
                }
                if (goApp["PageLoginRequiredId"] is null)
                {
                    goApp["PageLoginRequiredId"] = (object)await moDbHelper.getPageIdFromPathAsync(
                        LoginRequiredPagePath,
                        false,
                        false,
                        cancellationToken
                    ).ConfigureAwait(false);
                }
                if (goApp["PageErrorId"] is null)
                {
                    goApp["PageErrorId"] = (object)await moDbHelper.getPageIdFromPathAsync(
                        ProteanErrorPagePath,
                        false,
                        false,
                        cancellationToken
                    ).ConfigureAwait(false);
                }

                gnPageNotFoundId = Convert.ToInt64(goApp["PageNotFoundId"]);
                gnPageAccessDeniedId = Convert.ToInt64(goApp["PageAccessDeniedId"]);
                gnPageLoginRequiredId = Convert.ToInt64(goApp["PageLoginRequiredId"]);
                gnPageErrorId = Convert.ToInt64(goApp["PageErrorId"]);

                mcPagePath = moRequest["path"] + "";
                mcPagePath = mcPagePath.Replace("//", "/");

                if (Strings.LCase(moConfig["CheckDetailPath"]) == "on")
                {
                    mbCheckDetailPath = true;
                }

                JSStart.InitialiseJSEngine();

                // Get the User ID
                if (moSession != null)
                {
                    Cms argmyWeb = this;
                    if (moMemProv == null)
                    {
                        Protean.Providers.Membership.ReturnProvider RetProv = new Protean.Providers.Membership.ReturnProvider();
                        moMemProv = RetProv.Get(ref argmyWeb, moConfig["MembershipProvider"]);
                        RetProv = null;
                    }
                    mnUserId = Convert.ToInt16(moMemProv.Activities.GetUserId(ref argmyWeb));
                }
                moDbHelper.mnUserId = (long)mnUserId;

                // Initialise the cart
                if (gbCart | gbQuote)
                {
                    InitialiseCart();
                    if (moCart != null)
                    {
                        var argaWeb = this;
                        moDiscount = new Cms.Cart.Discount(ref argaWeb);
                        moDiscount.mcCurrency = moCart.mcCurrency;
                    }
                }

                // Facility to allow the generation bespoke errors
                if (moRequest["ewerror"] != null)
                {
                    throw new Exception(Strings.LCase("errortest:" + moRequest["ewerror"]));
                }

                // Logon Redirect Facility
                if (mbAdminMode)
                {
                    string ewCmd;
                    if (moSession["ewCmd"] != null &&
                        moSession["ewCmd"].ToString().Equals("PreviewOn", StringComparison.OrdinalIgnoreCase) &&
                        moRequest["ewCmd"]?.ToLower() == "logoff")
                    {
                        ewCmd = "PreviewOn";
                    }
                    else
                    {
                        ewCmd = Convert.ToString(Interaction.IIf(string.IsNullOrEmpty(moRequest["ewCmd"]), moSession["ewCmd"], moRequest["ewCmd"]));
                    }

                    if (Convert.ToInt64("0" + moConfig["AdminRootPageId"]) > 0L & Strings.LCase(ewCmd) != "logoff")
                    {
                        rootPageIdFromConfig = moConfig["AdminRootPageId"];
                    }
                    else if (Convert.ToInt64("0" + moConfig["AuthenticatedRootPageId"]) > 0L && mnUserId > 0 && !moDbHelper.checkUserRole("Administrator"))
                    {
                        rootPageIdFromConfig = moConfig["AuthenticatedRootPageId"];
                    }
                }
                else if (mnUserId > 0 & Convert.ToInt64("0" + moConfig["AuthenticatedRootPageId"]) > 0L)
                {
                    rootPageIdFromConfig = moConfig["AuthenticatedRootPageId"];
                }

                if (Tools.Number.IsStringNumeric(rootPageIdFromConfig))
                    RootPageId = Convert.ToInt32(rootPageIdFromConfig);

                GetRequestLanguage();

                long newPageId = 0L;

                if (mnPageId < 1)
                {
                    if (!string.IsNullOrEmpty(moRequest["pgid"]))
                    {
                        object sPageId = Regex.Replace("0" + moRequest["pgid"], @"[^\d]", "");
                        int argresult = 0;
                        if (int.TryParse(Convert.ToString(sPageId), out argresult))
                        {
                            mnPageId = Convert.ToInt16(sPageId);
                        }

                        if (!mbAdminMode)
                        {
                            newPageId = await moDbHelper.checkPagePermissionAsync(
                                (long)mnPageId,
                                cancellationToken
                            ).ConfigureAwait(false);
                        }
                        else if (!await moDbHelper.checkPageExistAsync(
                            (long)mnPageId,
                            cancellationToken
                        ).ConfigureAwait(false) && !mbAdminMode)
                        {
                            newPageId = gnPageNotFoundId;
                            gnResponseCode = 404L;
                        }
                    }
                    else
                    {
                        // Check for a redirect path
                        if (legacyRedirection())
                            return;

                        if (!(string.IsNullOrEmpty(moRequest["path"]) | mcPagePath == "/"))
                        {
                            // Then pathname (ASYNC)
                            var (pageId, artId, success) = await moDbHelper.getPageAndArticleIdFromPathAsync(
                                mcPagePath,
                                bSetGlobalPageVariable: true,
                                bCheckPermissions: true,
                                cancellationToken: cancellationToken
                            ).ConfigureAwait(false);

                            // Unpack tuple values into class members
                            mnPageId = (int)pageId;
                            mnArtId = (int)artId;

                            if (!mbAdminMode)
                            {
                                newPageId = await moDbHelper.checkPagePermissionAsync(
                                    (long)mnPageId,
                                    cancellationToken
                                ).ConfigureAwait(false);
                            }
                        }
                        else
                        {
                            // Then root
                            mnPageId = RootPageId;
                        }
                    }
                }

                if (!string.IsNullOrEmpty(mcPagePath) & mnPageId == RootPageId & mbAdminMode)
                {
                    // TS Removed because not quite sure what is going on...
                }

                if (newPageId > 0L & newPageId == gnPageLoginRequiredId & mnUserId == 0)
                {
                    moSession["LogonRedirectId"] = (object)mnPageId;
                }

                if (newPageId > 0L)
                    mnPageId = (int)newPageId;

                // Check for cloned pages, and clone contexts (ASYNC)
                if (gbClone)
                {
                    mnClonePageId = await moDbHelper.getClonePageIDAsync(
                        mnPageId,
                        cancellationToken
                    ).ConfigureAwait(false);

                    if (mnClonePageId > 0)
                        mbIsClonePage = true;

                    cCloneContext = moRequest["context"];
                    if (Tools.Number.IsNumeric(cCloneContext) && Convert.ToInt32(cCloneContext) > 0)
                    {
                        mnCloneContextPageId = Convert.ToInt32(cCloneContext);
                    }
                }

                if (!mbAdminMode)
                {
                    if ((long)mnPageId == gnPageNotFoundId | (long)mnPageId == gnPageAccessDeniedId | (long)mnPageId == gnPageLoginRequiredId | (long)mnPageId == gnPageErrorId)
                    {
                        if (RootPageId != mnPageId)
                        {
                            mbSystemPage = true;

                            if ((long)mnPageId == gnPageAccessDeniedId | (long)mnPageId == gnPageLoginRequiredId)
                            {
                                // moResponse.StatusCode = 401
                            }
                            if ((long)mnPageId == gnPageNotFoundId)
                            {
                                gnResponseCode = 404L;
                            }
                            if ((long)mnPageId == gnPageErrorId)
                            {
                                gnResponseCode = 500L;
                            }
                        }
                    }
                }

                if (mnArtId < 1)
                {
                    if (!string.IsNullOrEmpty(moRequest["artid"]))
                    {
                        mnArtId = GetRequestItemAsInteger("artid", 0);
                    }
                }

                if (ibIndexMode)
                {
                    mbAdminMode = false;
                    mnUserId = 1;
                }

                // Version Control: Set a permission state for this page (ASYNC)
                if (moSession != null)
                {
                    if (gbVersionControl)
                    {
                        mnUserPagePermission = await moDbHelper.getPagePermissionLevelAsync(
                            (long)mnPageId,
                            cancellationToken
                        ).ConfigureAwait(false);
                    }
                }
            }
            catch (Exception ex)
            {
                OnComponentError(this, new Tools.Errors.ErrorEventArgs(mcModuleName, "OpenAsync", ex, sProcessInfo));
            }
        }



        #region Async Page Rendering Methods

        /// <summary>
        /// Asynchronously gets the complete page HTML with full feature support.
        /// This is the complete async version of GetPageHTML() with all functionality.
        /// </summary>
        /// <param name="cancellationToken">Cancellation token</param>
        /// <returns>Task containing the rendered page</returns>
        public virtual async Task GetPageHTMLAsync(
            CancellationToken cancellationToken = default(CancellationToken))
        {
            PerfMon.Log("Web", "GetPageHTMLAsync - start");
            string sProcessInfo = "";
            string sCachePath = "";
            string sServeFile = "";

            try
            {
                switch (moResponseType)
                {
                    case pageResponseType.ajaxadmin:
                        {
                            // TS 21-06-2017 Moved from New() as not required for cached pages
                            Open();
                            GetAjaxHTML("MenuNode");
                            break;
                        }

                    case pageResponseType.json:
                        {
                            var moApi = new Protean.rest();
                            moApi.InitialiseVariables();
                            moApi.JSONRequest();
                            break;
                        }

                    case pageResponseType.qrcode:
                        {
                            // QRcode generation
                            string QRPath = moRequest.RawUrl.ToString();
                            QRPath = QRPath.Replace("/QRcode", "");
                            // Replace the QRPath concatenation with proper C# string building
                            string protocol = moRequest.ServerVariables["SERVER_PORT_SECURE"] == "0"
                                ? "http://"
                                : "https://";
                            string serverName = moRequest.ServerVariables["SERVER_NAME"];
                            QRPath = protocol + serverName + QRPath;

                            var qrGenerator = new QRCoder.QRCodeGenerator();
                            var qrCodeData = qrGenerator.CreateQrCode(QRPath, QRCoder.QRCodeGenerator.ECCLevel.Q);
                            var qrCode = new QRCoder.QRCode(qrCodeData);
                            var qrCodeImage = qrCode.GetGraphic(20);

                            moResponse.ContentType = mcContentType;
                            qrCodeImage.Save(moResponse.OutputStream, System.Drawing.Imaging.ImageFormat.Png);
                            moResponse.End();
                            break;
                        }

                    default:
                        {
                            CheckPagePath();

                            // Check if cart exists in session
                            if (moSession != null)
                            {
                                if (gbCart | gbQuote)
                                {
                                    if (Convert.ToInt16("0" + moSession["CartId"] ?? string.Empty) > 0)
                                    {
                                        bPageCache = false;
                                    }
                                }
                            }

                            // Handle reBundle request
                            if (moRequest["reBundle"] != null)
                            {
                                if (moRequest["SessionId"] != null)
                                {
                                    RestoreRedirectSession(moRequest["SessionId"], 5, true);
                                }

                                if (mbAdminMode)
                                {
                                    goApp.Clear();
                                    ClearPageCache();
                                    ClearBundleCache("js");
                                    ClearBundleCache("css");
                                }
                            }

                            // Check for page cache
                            if (bPageCache & !ibIndexMode & !(gnResponseCode == 404L))
                            {
                                sCachePath = goServer.UrlDecode(mcOriginalURL);
                                if (sCachePath.Contains("?"))
                                {
                                    sCachePath = sCachePath.Substring(0, sCachePath.IndexOf("?"));
                                }
                                sCachePath = sCachePath + ".html";

                                if (!string.IsNullOrEmpty(gcProjectPath))
                                {
                                    sCachePath = sCachePath.Replace(gcProjectPath, "");
                                }

                                if (sCachePath == "/.html" | sCachePath == ".html")
                                {
                                    sCachePath = "/home.html";
                                }

                                long nCacheTimeout = 24L;
                                if (Protean.Tools.Number.IsNumeric(moConfig["PageCacheTimeout"]))
                                {
                                    nCacheTimeout = Convert.ToInt64(moConfig["PageCacheTimeout"]);
                                }

                                var oFS = new Protean.fsHelper(moCtx);
                                oFS.mcRoot = gcProjectPath;
                                oFS.mcStartFolder = goServer.MapPath(@"\" + gcProjectPath).TrimEnd('\\') + mcPageCacheFolder;

                                if (Convert.ToBoolean(oFS.VirtualFileExistsAndRecent(sCachePath, nCacheTimeout)))
                                {
                                    sServeFile = mcPageCacheFolder + sCachePath;
                                }
                            }

                            // Set response headers
                            moResponse.HeaderEncoding = System.Text.Encoding.UTF8;
                            moResponse.ContentEncoding = System.Text.Encoding.UTF8;
                            moResponse.Expires = 0;
                            moResponse.AppendHeader("Generator", gcGenerator);

                            if (string.IsNullOrEmpty(sServeFile))
                            {
                                // ✅ ASYNC: Open and build page
                                Open();

                                if (!string.IsNullOrEmpty(msException))
                                {
                                    sProcessInfo = "we should stop now";
                                }

                                if (mbAdminMode & !ibIndexMode & !(gnResponseCode == 404L))
                                {
                                    bPageCache = false;
                                }

                                sProcessInfo = "Transform PageXML Using XSLT";

                                // Admin mode processing
                                if (mbAdminMode & !ibIndexMode & !(gnResponseCode == 404L))
                                {
                                    sProcessInfo = "In Admin Mode";
                                    if (moAdmin is null)
                                    {
                                        var argaWeb = this;
                                        moAdmin = new Cms.Admin(ref argaWeb);
                                    }

                                    moAdmin.open(moPageXml);
                                    var argoWeb = this;
                                    moAdmin.adminProcess(ref argoWeb);
                                    moAdmin.close();
                                    moAdmin = (Cms.Admin)null;
                                }
                                else if (string.IsNullOrEmpty(moPageXml.OuterXml))
                                {
                                    sProcessInfo = "Getting Page XML";

                                    // ✅ ASYNC: Get page XML
                                    await GetPageXMLAsync(cancellationToken).ConfigureAwait(false);
                                }

                                // Check for flush response type
                                if (moResponseType == pageResponseType.flush)
                                {
                                    moResponse.Flush();
                                    moResponse.End();
                                    Close();
                                }
                                else
                                {
                                    // Set content type and disposition
                                    if (!string.IsNullOrEmpty(msException))
                                    {
                                        moResponse.AddHeader("X-ProteanCMSError", "An Error has occured");
                                        gnResponseCode = 500L;
                                        moResponse.ContentType = "text/html";
                                        bPageCache = false;
                                    }
                                    else
                                    {
                                        if (mcContentType == "application/x-www-form-urlencoded")
                                        {
                                            moResponse.ContentType = "text/html";
                                        }
                                        else
                                        {
                                            moResponse.ContentType = mcContentType;
                                        }

                                        if (!string.IsNullOrEmpty(mcContentDisposition))
                                        {
                                            moResponse.AddHeader("Content-Disposition", mcContentDisposition);
                                        }

                                        if (mcContentType != "text/html" & !string.IsNullOrEmpty(mcContentDisposition))
                                        {
                                            bPageCache = false;
                                        }
                                    }

                                    if (bPageCache == false)
                                    {
                                        sServeFile = "";
                                    }

                                    if (!string.IsNullOrEmpty(msRedirectOnEnd))
                                    {
                                        moPageXml = null;
                                        Close();
                                    }
                                    else
                                    {
                                        // Check XML output restrictions
                                        if (mbOutputXml)
                                        {
                                            if (!string.IsNullOrEmpty(moConfig["XmlAllowedIPList"]))
                                            {
                                                if (!Tools.Text.IsIPAddressInList(
                                                    moRequest.ServerVariables["REMOTE_ADDR"],
                                                    moConfig["XmlAllowedIPList"]))
                                                {
                                                    mbOutputXml = false;
                                                }
                                            }
                                        }

                                        // Output as XML or transform to HTML
                                        if (mbOutputXml == true)
                                        {
                                            switch (mcContentType.ToLower() ?? "")
                                            {
                                                case "application/xml":
                                                    {
                                                        moResponse.Write("<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
                                                            moPageXml.OuterXml);
                                                        break;
                                                    }
                                                case "application/json":
                                                    {
                                                        moResponse.Write(Newtonsoft.Json.JsonConvert.SerializeXmlNode(
                                                            moPageXml.DocumentElement,
                                                            Newtonsoft.Json.Formatting.None));
                                                        break;
                                                    }
                                            }
                                        }
                                        else
                                        {
                                            // ✅ Handle different response types
                                            if (moResponseType == pageResponseType.pdf)
                                            {
                                                await HandlePDFResponseAsync(cancellationToken).ConfigureAwait(false);
                                            }
                                            else
                                            {
                                                // ✅ SYNC: Transform to HTML (CPU-bound, no async benefit)
                                                string html = TransformPageHTML();

                                                if (bPageCache)
                                                {
                                                    if (gnResponseCode != 200L)
                                                    {
                                                        moResponse.TrySkipIisCustomErrors = true;
                                                        moResponse.StatusCode = (int)gnResponseCode;
                                                    }

                                                    moResponse.Write(html);
                                                    moResponse.Flush();
                                                    gnResponseCode = 200L;
                                                    SavePage(sCachePath, html);
                                                }
                                                else
                                                {
                                                    moResponse.Write(html);
                                                }
                                            }
                                        }

                                        // Set response status code
                                        if (gnResponseCode != 200L)
                                        {
                                            moResponse.TrySkipIisCustomErrors = true;
                                            moResponse.StatusCode = (int)gnResponseCode;
                                        }

                                        // Cleanup
                                        if (!ibIndexMode)
                                        {
                                            if (string.IsNullOrEmpty(msRedirectOnEnd))
                                            {
                                                moPageXml = null;
                                                if (string.IsNullOrEmpty(sServeFile))
                                                {
                                                    Close();
                                                }
                                            }
                                            else
                                            {
                                                moPageXml = null;
                                                if (string.IsNullOrEmpty(sServeFile))
                                                {
                                                    Close();
                                                }
                                            }
                                        }
                                        else
                                        {
                                            moPageXml = new XmlDocument();
                                        }
                                    }
                                }
                            }

                            // Store previous page in session
                            if (moSession != null)
                            {
                                moSession["previousPage"] = mcOriginalURL;
                            }

                            // Serve cached file if available
                            if (!string.IsNullOrEmpty(sServeFile))
                            {
                                if (!string.IsNullOrEmpty(moConfig["xframeoptions"]))
                                {
                                    moResponse.AddHeader("X-Frame-Options", moConfig["xframeoptions"]);
                                }
                                else
                                {
                                    moResponse.AddHeader("X-Frame-Options", "DENY");
                                }

                                short filelen = (short)(goServer.MapPath("/" + gcProjectPath).Length + sServeFile.Length);
                                DateTime UpdatedTime = mdPageUpdateDate ?? DateTime.Now;
                                moResponse.AddHeader("Last-Modified", Tools.Text.HtmlHeaderDateTime(UpdatedTime));

                                PerfMon.Log("Web", "GetPageHTML - serve cached file");

                                if (filelen > 260)
                                {
                                    moResponse.Write(Alphaleonis.Win32.Filesystem.File.ReadAllText(
                                        goServer.MapPath("/" + gcProjectPath) + sServeFile));
                                }
                                else
                                {
                                    moResponse.WriteFile(goServer.MapPath("/" + gcProjectPath) + sServeFile);
                                }
                                Close();
                            }

                            break;
                        }
                }

                // Clear recaptcha flag
                if (moSession != null)
                {
                    moSession["recaptcha"] = (object)null;
                }
            }
            catch (Exception ex)
            {
                if ((mcEwSiteXsl ?? "") != (moConfig["SiteXsl"] ?? ""))
                    mcEwSiteXsl = moConfig["SiteXsl"];

                OnComponentError(this, new Tools.Errors.ErrorEventArgs(
                    mcModuleName, "GetPageHTMLAsync", ex, sProcessInfo));

                moResponse.Write(msException);
            }
            finally
            {
                // Handle redirects
                if (!string.IsNullOrEmpty(msRedirectOnEnd))
                {
                    if (!msRedirectOnEnd.StartsWith("http"))
                    {
                        msRedirectOnEnd = msRedirectOnEnd.Replace("//", "/");
                    }

                    if (Convert.ToBoolean(mbRedirectPerm))
                    {
                        moResponse.RedirectPermanent(msRedirectOnEnd, false);
                    }
                    else
                    {
                        moResponse.Redirect(msRedirectOnEnd, false);
                        if (bRestartApp)
                        {
                            RestartAppPool();
                        }
                    }
                }
                else if (bRestartApp)
                {
                    moResponse.Redirect("/", false);
                    RestartAppPool();
                }

                PerfMon.Log("Web", "GetPageHTMLAsync-Final");
                PerfMon.Write();
            }
        }

        /// <summary>
        /// Handles PDF response generation asynchronously
        /// </summary>
        private async Task HandlePDFResponseAsync(CancellationToken cancellationToken)
        {
            mcContentType = "application/pdf";

            moDbHelper.logActivity(Cms.dbHelper.ActivityType.Custom1,
                (long)mnUserId, 0L, 0L, 0L, "Create Pdf", false);

            string styleFile = goServer.MapPath(mcEwSiteXsl);
            PerfMon.Log("Web", "ReturnPageHTML - loaded Style");

            var argaWeb = this;
            var oTransform = new Protean.XmlHelper.Transform(ref argaWeb, styleFile, false);
            oTransform.mbDebug = gbDebug;

            msException = "";
            icPageWriter = new StringWriter();
            TextWriter argoWriter = icPageWriter;
            oTransform.ProcessTimed(moPageXml, ref argoWriter);
            icPageWriter = (StringWriter)argoWriter;

            string foNetXml = icPageWriter.ToString();

            moDbHelper.logActivity(Cms.dbHelper.ActivityType.Custom1,
                (long)mnUserId, 0L, 0L, 0L, "Create Pdf Transformed", false);

            if (foNetXml.StartsWith("<html"))
            {
                moResponse.Write(foNetXml);
            }
            else
            {
                moDbHelper.logActivity(Cms.dbHelper.ActivityType.Custom1,
                    (long)mnUserId, 0L, 0L, 0L, "FO.Net-Start", false);

                // Generate PDF using FO.Net
                string strFileName = mcOutputFileName;
                var oFoNet = new Fonet.FonetDriver();
                var ofileStream = new MemoryStream();
                var oTxtReader = new StringReader(foNetXml);
                oFoNet.CloseOnExit = false;

                var rendererOpts = new Fonet.Render.Pdf.PdfRendererOptions();
                rendererOpts.Author = "ProteanCMS";
                rendererOpts.EnablePrinting = true;
                rendererOpts.FontType = Fonet.Render.Pdf.FontType.Embed;

                // Add fonts
                string fontPath = goServer.MapPath("") + "/fonts";
                if (bs5)
                {
                    fontPath = goServer.MapPath("") + "/fonts";
                }

                var dir = new DirectoryInfo(fontPath);
                if (dir.Exists)
                {
                    FileInfo[] files = dir.GetFiles();
                    foreach (var fi in files)
                    {
                        string cExt = fi.Extension.ToLower();
                        if (cExt == ".otf")
                        {
                            rendererOpts.AddPrivateFont(fi);
                        }
                    }
                }

                fontPath = goServer.MapPath("/ewcommon") + "/fonts";
                if (bs5)
                {
                    fontPath = goServer.MapPath("/ptn") + "/fonts";
                }

                dir = new DirectoryInfo(fontPath);
                if (dir.Exists)
                {
                    FileInfo[] files = dir.GetFiles();
                    foreach (var fi in files)
                    {
                        string cExt = fi.Extension.ToLower();
                        if (cExt == ".otf")
                        {
                            rendererOpts.AddPrivateFont(fi);
                        }
                    }
                }

                oFoNet.Options = rendererOpts;
                oFoNet.Render(oTxtReader, ofileStream);

                moResponse.Buffer = true;
                moResponse.Expires = 0;
                goServer.ScriptTimeout = 10000;

                string strFileSize = ofileStream.Length.ToString();
                byte[] Buffer = ofileStream.ToArray();

                moCtx.Response.Clear();
                moCtx.Response.AddHeader("Connection", "keep-alive");

                if (moCtx.Request.QueryString["mode"] == "open")
                {
                    moCtx.Response.AddHeader("Content-Disposition",
                        "filename=" + strFileName.Replace(",", ""));
                }
                else
                {
                    moCtx.Response.AddHeader("Content-Disposition",
                        "attachment; filename=" + strFileName.Replace( ",", ""));
                }

                moCtx.Response.AddHeader("Content-Length", strFileSize);
                moCtx.Response.ContentType = Tools.FileHelper.GetMIMEType("PDF");
                moCtx.Response.BinaryWrite(Buffer);
                moCtx.Response.Flush();

                moDbHelper.logActivity(Cms.dbHelper.ActivityType.Custom1,
                    (long)mnUserId, 0L, 0L, 0L, "FO.Net-End", false);

                oFoNet = null;
                oTxtReader = null;
                ofileStream = null;
            }

            // Allow async continuation (no actual await needed for PDF generation)
            await Task.CompletedTask;
        }

