<?xml version="1.0" encoding="utf-8"?>
<Content type="xform" name="EditContent">
  <model>
    <instance>
      <tblContent>
        <nContentKey/>
        <nContentPrimaryId/>
        <nVersion/>
        <cContentForiegnRef/>
        <cContentName/>
        <cContentSchemaName>Module</cContentSchemaName>
        <cContentXmlBrief>
          <Content moduleType="ContentFilter" filterTarget="Product" contentType="ContentFilter" resultCount="0" box="" title="" link="" linkType="filter" order="Position" cols="1" stepBy="" stepCount="24" display="all" position="" action="Protean.Cms+Content+Modules.ContentFilter" ShowContentListlevel="false" heading="h2">
            </Content>
			
        </cContentXmlBrief>
        <cContentXmlDetail/>
        <nAuditId/>
        <nAuditKey/>
        <dPublishDate/>
        <dExpireDate/>
        <dInsertDate/>
        <nInsertDirId/>
        <dUpdateDate/>
        <nUpdateDirId/>
        <nStatus>1</nStatus>
        <cDescription/>
        <bCascade/>
      </tblContent>
    </instance>
    <submission id="EditContent" action="" method="post" event="return form_check(this)"/>
    <bind id="cModuleTitle" nodeset="tblContent/cContentName" required="false()" type="string"/>
    <bind nodeset="tblContent/cContentXmlBrief/Content">
      <bind id="cPosition" nodeset="@position" required="true()" type="string"/>
      <bind id="cModuleType" nodeset="@moduleType" required="true()" type="string"/>
	  <bind id="cfilterTarget" nodeset="@filterTarget" required="true()" type="string"/>
      <bind id="cModuleBox" nodeset="@box" required="false()" type="string"/>
      <bind id="cModuleTitle" nodeset="@title" required="false()" type="string"/>
      <bind id="cModuleLink" nodeset="@link" required="false()" type="string"/>
      <bind id="cLinkType" nodeset="@linkType" required="false()" type="string"/>
      <bind id="cModuleLinkText" nodeset="@linkText" required="false()" type="string"/>
      <bind id="nColumns" nodeset="@cols" required="false()" type="string"/>
      <bind id="carousel" nodeset="@carousel" required="false()" type="string"/>
      <bind id="carouselBullets" nodeset="@carouselBullets" required="false()" type="string"/>
      <bind id="nStepCount" nodeset="@stepCount" required="false()" type="string"/>
      <bind id="cDisplay" nodeset="@display" required="false()" type="string"/>
      <bind id="cSortBy" nodeset="@sortBy" required="false()" type="string"/>
      <bind id="cStepBy" nodeset="@stepBy" required="false()" type="string"/>
      <bind id="cPageOrder" nodeset="@order" required="false()" type="string"/>
		<bind id="bShowContentListlevel" nodeset="@ShowContentListlevel" required="true()" type="string"/>
    </bind>
    <bind id="cContentBody" nodeset="tblContent/cContentXmlBrief/Content" required="false()" type="string"/>
    <ewInclude filePath="/ptn/core/modules/genericmodule.xml" xPath="descendant-or-self::bind[@nodeset='tblContent/cContentXmlBrief/Content']"/>
    <ewInclude filePath="/ptn/core/modules/genericmodule.xml" xPath="descendant-or-self::bind[@id='columnBind']"/>
    <ewInclude filePath="/ptn/core/modules/genericmodule.xml" xPath="descendant-or-self::bind[@nodeset='tblContent']"/>
  </model>
  <group ref="EditContent" class="2col">
    <label>Content Filter Module</label>
   <group  class="tabs">
	<group>
				<label>
					<i class="fas fa-pen"> </i>
					<span class="space"> </span>
					<span>Content</span>
				</label>
	<group>
        <!-- These hidden fields and bindings are required for the component-->
        <input bind="nContentKey" class="hidden"/>
 <input bind="cModuleTitle" class="long">
          <label>Title or Name</label>
        </input>
        <group>
          <label>Filters</label>
            <group class="getFilterButtons" />
        </group>
		  <select1 bind="bShowContentListlevel"  appearance="full" class="form-group ">
			  <label>Display On Content List Page</label>
			  <item>
				  <label>Yes</label>
				  <value>true</value>
			  </item>
			  <item>
				  <label>No</label>
				  <value>false</value>
			  </item>
		  </select1>

				</group>
				</group>
			
  
	<group>
				<label>
					<i class="fas fa-brush"> </i>
					<span class="space"> </span>
					<span>Presentation</span>
				</label>
				<ewInclude filePath="/ptn/core/modules/genericmodule.xml" xPath="descendant-or-self::group[@id='presentation']"/>
				<group class="row">
					<input bind="maxWidth" class="col-lg-6">
						<label>Max Width</label>
						<value></value>
						<help class="inline">Add a value ending either px or %.</help>
					</input>
          <input bind="padding" class="col-lg-6">
            <label>Padding</label>
            <value></value>
          </input>
          <group class="container-fluid">
            <group class="form-section-wrapper form-section-wrapper-wide">
              <label>Alignment</label>
              <group class="row row-cols-sm-2">
                <group class="col-lg-6">
                  <select1 bind="char80Layout" >
                    <label>Layout of content</label>
                    <item>
                      <label>Centre</label>
                      <value>center</value>
                    </item>
                    <item>
                      <label>Left</label>
                      <value>left</value>
                    </item>
                    <item>
                      <label>Right</label>
                      <value>right</value>
                    </item>
                    <item>
                      <label>Wide</label>
                      <value>wide</value>
                    </item>
                  </select1>
                </group>
                <group class="col-lg-6">
                  <select1 bind="v-align" >
                    <label>Vertical alignment</label>
                    <item>
                      <label>Top</label>
                      <value>top</value>
                    </item>
                    <item>
                      <label>Center</label>
                      <value>center</value>
                    </item>
                    <item>
                      <label>Bottom</label>
                      <value>bottom</value>
                    </item>
                  </select1>
                </group>
              </group>
            </group>
          </group>
        </group>
		
			</group>
				<group>
				<label>
					<i class="fas fa-cog"> </i>
					<span class="space"> </span>
					<span>Advanced Settings</span>
				</label>
				<group>
					<!-- These hidden fields and bindings are required for the component-->
					<input bind="nContentKey" class="hidden">
						<label>ContentId</label>
					</input>
					<input bind="cModuleType" class="hidden">
						<label>ModuleType</label>
					</input>
					<!-- end of hidden fields -->
					<ewInclude filePath="/ptn/core/modules/genericmodule.xml" xPath="descendant-or-self::group[@id='publish']"/>
				</group>
			</group>
	</group>
    </group>
  
  

  <group ref="submit" class="contentSubmit">
    <submit submission="" ref="ewSubmit" class="principle">
      <label>Save Content Filter</label>
    </submit>
  </group>
</Content>
